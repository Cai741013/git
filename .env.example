# 选择 deepseek 或 openai
AI_PROVIDER=deepseek

# DeepSeek 配置（在 https://platform.deepseek.com/api_keys 创建）
DEEPSEEK_API_KEY=sk-your-key-here
AI_MODEL=deepseek-chat

# 如切换为 OpenAI，请把 AI_PROVIDER 改为 openai，并填写下面两项
# OPENAI_API_KEY=sk-your-key-here
# AI_MODEL=gpt-5.6-terra
PORT=4173

# 云服务器部署时使用；本地开发不要修改 HOST
HOST=127.0.0.1

# 分享给使用者的访问口令，以及每个 IP 每小时最多生成次数
ACCESS_CODE=change-this-password
RATE_LIMIT_PER_HOUR=20

# 中国大陆网络环境如使用本地代理，可取消下面两行注释并修改端口
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
